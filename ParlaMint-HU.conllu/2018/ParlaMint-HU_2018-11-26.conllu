# newpar id = u2018-11-26-243.7
# lang = hu
# sent_id = ParlaMint-HU_2018-11-26.seg768.1
# senti_3 = Positive
# senti_6 = mixed positive
# senti_n = 3.623
# text = A szolidaritási hozzájárulás rendszere emellett az egyik évről a másikra jelentkező önkormányzati többletbevételek egészét nem vonja el, tehát az önkormányzatok is profitálnak a többletbevételekből, tehát amikor képviselő úr arról beszél, hogy egyik évről a másikra növekedett valamelyik önkormányzatnak a szolidaritási hozzájárulási kötelezettsége, akkor azt is hozzá kell tenni, hogy az önkormányzatnak az összbevételei és a jövedelmi helyzete is javult.
