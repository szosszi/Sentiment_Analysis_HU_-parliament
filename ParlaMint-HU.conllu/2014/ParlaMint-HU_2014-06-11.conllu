# newpar id = u2014-06-11-3.2
# lang = hu
# sent_id = ParlaMint-HU_2014-06-11.seg12.1
# senti_3 = Positive
# senti_6 = positive
# senti_n = 4.717
# text = Ehhez képest valóban Magyarország saját erejéből kezdte el csökkenteni az államadósságát, került ki a túlzottdeficit-eljárás alól, és a magyar kormány mindezt úgy tette meg, hogy egyetlen fillér külső segítséget sem kellett igénybe venni hozzá, tehát sem az IMF, sem az Európai Unió külső támogatására nem volt szükség.
