# newpar id = u2015-06-10-57.7
# lang = hu
# sent_id = ParlaMint-HU_2015-06-10.seg326.1
# senti_3 = Neutral
# senti_6 = neutral postive
# senti_n = 2.514
# text = De ha már terminológiánál és definícióknál járunk - pontosan azért, hogy megértsék az adósok, megértsék az ebben részt venni kívánók a működési elvét - , nagyon fontos lenne, hogy beszéljünk olyan terminológiáról, olyan definíciókról, amelyekből ötvennél is többet tartalmaz, mintegy taxatív felsorolást a jogszabály, hiszen olyan új újdonságokkal, ha tetszik, olyan jogintézményekkel vagy a jogszabályba beépülő nagyon fontos, kulcsfontosságú momentumokkal találkozhatunk, mint például az, hogy mit is jelent a méltányolható lakásigény, vagy mit jelent az, hogy a lakhatási feltételek megtartására szolgáló ingatlan.
