# newpar id = u2015-11-05-69.7
# lang = hu
# sent_id = ParlaMint-HU_2015-11-05.seg372.1
# senti_3 = Negative
# senti_6 = negative
# senti_n = 0.239
# text = Tudja, ugyanezt csinálják a Parlament falai között, hogy ha a parlamenti patkóban ülő ellenzéki pártok bármilyen kérdéskörrel kapcsolatban jobbító szándékú véleményeket sorakoztatnak fel, vagy módosító indítványokat tesznek, vagy bármit csinálnak, kényszeredett módon ketten-hárman - mint ahogy most is - a Fidesz-KDNP frakciójából meghallgatják, mert hát kettő-három embernek csak itt kell lenni, egyébként meg tudja, mit csinálnak vele.
