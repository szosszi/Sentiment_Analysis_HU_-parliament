# newpar id = u2017-05-29-93.4
# lang = hu
# sent_id = ParlaMint-HU_2017-05-29.seg357.1
# senti_3 = Positive
# senti_6 = mixed positive
# senti_n = 3.946
# text = Biztosíthatom önt, hogy a magyar diplomácia más uniós tagállamok mellett minden érdemi fórumon felhívja a figyelmet az öt integrációs kulcsterületben meghatározott feladatok maradéktalan teljesítésének fontosságára, és kiemelten figyelmet fordítunk az albániai kábítószer-termelés és kábítószer-kereskedelem kérdéskörére, annak összefonódására albán politikai körökkel, és bízunk abban, hogy az Európai Unió is odafigyel ezekre a folyamatokra.
