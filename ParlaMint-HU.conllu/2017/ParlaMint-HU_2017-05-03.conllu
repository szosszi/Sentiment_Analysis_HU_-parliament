# newpar id = u2017-05-03-25.2
# lang = hu
# sent_id = ParlaMint-HU_2017-05-03.seg181.1
# senti_3 = Positive
# senti_6 = mixed positive
# senti_n = 3.730
# text = A kínai vezetés 100 milliárd USA-dollár törzstőkével hozta létre ezt a fejlesztési bankot abból a célból, hogy ázsiai infrastrukturális beruházásokat finanszírozzon ebből, s talán láthatjuk azt, talán már mindenki láthatja azt, hogy talán ami a világban végbemenő gazdasági fejlődést, gazdasági boomot jelenti, abban Ázsia a XXI. században vezető szerepet fog játszani, a jövőnek, a XXI. századnak a gazdasági-pénzügyi történelmét több mint valószínű, hogy Ázsiában fogják írni, ezért döntő jelentőségű egy ilyen infrastrukturális beruházási bank, és az, hogy ennek Magyarország is a része lehet.
