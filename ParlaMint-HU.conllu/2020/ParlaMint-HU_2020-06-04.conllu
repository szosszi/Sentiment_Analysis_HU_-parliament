# newpar id = u2020-06-04-168.4
# lang = hu
# sent_id = ParlaMint-HU_2020-06-04.seg1057.1
# senti_3 = Negative
# senti_6 = negative
# senti_n = 0.105
# text = Ami nagyon szomorú, hogy a koronavírus-járvány okozta válságot is ennek a bosszúnak a kiteljesítésére használja a miniszterelnök; és amikor elvonta a gépjárműadót, vagy felfüggesztette a parkolási bevételek, az idegenforgalmi bevételek önkormányzatokhoz való eljutását, akkor azt láttuk, hogy jó, rendben van, ezek talán átmeneti intézkedések, de most, amikor Varga Mihály benyújtotta a 2021-es költségvetési tervezetet, abból azt láttuk, hogy ezek az intézkedések állandó jelleggel itt maradnak velünk.
