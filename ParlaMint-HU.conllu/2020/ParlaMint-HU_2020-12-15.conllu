# newpar id = u2020-12-15-59.3
# lang = hu
# sent_id = ParlaMint-HU_2020-12-15.seg499.1
# senti_3 = Negative
# senti_6 = negative
# senti_n = 0.220
# text = Bizony ez egy súlyos probléma, és ez igencsak érintette a társadalomnak az igazságérzetét, mert nyílván súlyos köztörvényes bűnözők voltak azok, akik ezekhez az összegekhez hozzájutottak, és amikor azok az áldozatok, akik a bűncselekmények áldozatai voltak, és nagyon sok esetben, sőt általában nem jutottak hozzá a kártérítési összegekhez, amelyeket nekik a bíróság adott esetben megítélt, ezzel szemben azt látták, hogy sorozatban az elítélteket pedig milliós összegekkel kártalanítja az állam, nyilván ez felháborította az emberek igazságérzetét.
