# newpar id = u2022-11-10-87.2
# lang = hu
# sent_id = ParlaMint-HU_2022-11-10.seg566.1
# senti_3 = Negative
# senti_6 = negative
# senti_n = 0.398
# text = Azt tudjuk mondani itt azért most már jó pár éve, hogy ha, mondjuk, 2010-et számoljuk, amikor az LMP Magyarország Zöld Pártja az első zöldpártként bekerült a magyar Országgyűlésbe, nagyon komoly vitákat folytattak megelőző frakciók, illetve még az előző ciklusban mi is arról, hogy bizony ez a kormány mostohagyerekként kezeli a környezetvédelem ügyét, és nem jelenik meg ez a fajta felelős gondolkodás a gazdaságpolitikában, társadalompolitikában és egyáltalán a cselekvésben.
